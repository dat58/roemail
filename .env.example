# Copy this file to .env and fill in real values — .env is not committed to git.

# Your mail domain (bare, no "mail." prefix) — the single source of truth for
# every place that needs it. The server's own JMAP/web hostname is always
# "mail.<MAIL_DOMAIN>" by convention (see docker-compose.yml's `stalwart`
# service). Read by docker-compose.yml and email-worker/setup.sh.
MAIL_DOMAIN=example.com

# Stalwart's admin password. Used for:
#  - STALWART_RECOVERY_ADMIN when the container is first created (see docker-compose.yml)
#  - stalwart.sh, stalwart-cli, admin-app admin login
ADMIN_PASSWORD=change-this-password

# Cloudflare Tunnel token (Zero Trust dashboard → Networks → Tunnels →
# the tunnel in use → Configure → token). A real secret.
CLOUDFLARE_TUNNEL_TOKEN=

# Login password for the admin-app page (see admin-app/ in the README) — this
# is the only protection if you expose this page to the Internet via cloudflared.
APP_ADMIN_PASSWORD=change-this-password

# (optional) default password assigned to new mailboxes created via admin-app.
# Leave empty to use the default "Hellototo123$" in admin-app/src/stalwart.js.
DEFAULT_MAILBOX_PASSWORD=
